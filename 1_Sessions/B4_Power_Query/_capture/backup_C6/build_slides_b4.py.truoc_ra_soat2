def venn(s, x, y, kind, d=0.52):
    """[VẼ] Hai vòng tròn giao nhau (bảng trái, bảng phải); phần tô navy là phần Merge giữ lại.
    Vùng giao (hình thấu kính) vẽ gần đúng bằng một elip hẹp đặt đè lên chỗ chồng nhau."""
    step = 0.65 * d                                   # khoảng cách hai tâm: hai vòng chồng 35%
    lx, rx = x, x + step
    box(s, lx, y, d, d, fill=NAVY if kind in ("left", "anti") else WHITE, line=None, shape=MSO_SHAPE.OVAL, name=f"Venn {kind} trái")
    box(s, rx, y, d, d, fill=NAVY if kind == "right" else WHITE, line=None, shape=MSO_SHAPE.OVAL, name=f"Venn {kind} phải")
    lw_, lh_ = d - step, 0.76 * d
    box(s, rx, y + (d - lh_) / 2, lw_, lh_, fill=WHITE if kind == "anti" else NAVY, line=None, shape=MSO_SHAPE.OVAL, name=f"Venn {kind} giao")
    for xx, side in ((lx, "trái"), (rx, "phải")):
        box(s, xx, y, d, d, fill=None, line=NAVY, lw=1.25, shape=MSO_SHAPE.OVAL, name=f"Venn {kind} viền {side}")

